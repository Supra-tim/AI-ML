   ],
   "source": [
    "x= np.linspace(-2*np.pi, 2*np.pi, 100)\n",
    "y=np.sin(x)\n",
    "plt.plot(x,y, label='Y=sin(X)', color='blue')\n",
    "plt.xlabel(\"X\")\n",
    "plt.ylabel(\"Y=sin(X)\")\n",
    "plt.title(\"Graph od Sin(x)\")\n",
    "plt.grid(True)\n",
    "plt.show()"
   ]
  }
